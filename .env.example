# =============================================================
# File mẫu biến môi trường. KHÔNG commit file .env thật lên GitHub!
# Tạo .env với mật khẩu ngẫu nhiên:  sh scripts/gen-env.sh
# (hoặc copy file này thành .env rồi tự đổi toàn bộ mật khẩu)
# Yêu cầu mật khẩu: >= 16 ký tự, có chữ hoa, chữ thường, số.
# =============================================================

COMPOSE_PROJECT_NAME=taxi
DOMAIN=taxi.local

# Cổng public trên máy host (chỉ Nginx được public)
HTTP_PORT=80
HTTPS_PORT=443

# ---- PostgreSQL ----
POSTGRES_DB=taxi_booking
POSTGRES_USER=taxi_admin
POSTGRES_PASSWORD=CHANGE_ME_admin_password
# Tài khoản ứng dụng (chỉ SELECT/INSERT/UPDATE)
APP_DB_PASSWORD=CHANGE_ME_app_password
# Tài khoản báo cáo (chỉ đọc)
REPORT_DB_PASSWORD=CHANGE_ME_report_password
# Tài khoản cho postgres-exporter (pg_monitor)
MONITOR_DB_PASSWORD=CHANGE_ME_monitor_password

# ---- Ứng dụng web: tài khoản điều phối viên (tạo tự động khi app khởi động) ----
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=CHANGE_ME_app_admin_password
# Thời gian sống của phiên đăng nhập (giờ)
SESSION_TTL_HOURS=12
# Địa chỉ web dùng để tạo link trong email quên mật khẩu
APP_BASE_URL=https://localhost

# ---- Email (quên mật khẩu) ----
# Mặc định gửi vào Mailpit (hộp thư giả, xem tại https://localhost/mail/ - Basic Auth như Prometheus).
# Gửi email thật (vd Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<gmail>, SMTP_PASS=<app password>, và cho app ra Internet (xem README).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Taxi Booking <no-reply@taxi.local>

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@taxibooking.vn
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# ---- Grafana ----
GRAFANA_ADMIN_USER=taxiadmin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ---- Basic Auth bảo vệ Prometheus UI (https://<host>/prometheus/) ----
MONITOR_BASIC_AUTH_USER=monitor
MONITOR_BASIC_AUTH_PASSWORD=CHANGE_ME_basic_auth_password
