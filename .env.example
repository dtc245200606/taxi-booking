# =============================================================
# File mẫu biến môi trường. KHÔNG commit file .env thật lên GitHub!
# Tạo .env với mật khẩu ngẫu nhiên:  sh scripts/gen-env.sh
# (hoặc copy file này thành .env rồi tự đổi toàn bộ mật khẩu)
# Yêu cầu mật khẩu: >= 16 ký tự, có chữ hoa, chữ thường, số.
# =============================================================

COMPOSE_PROJECT_NAME=taxi
DOMAIN=taxi.local

# Cổng public trên máy host (chỉ Nginx được public)
HTTP_PORT=80
HTTPS_PORT=443

# ---- PostgreSQL ----
POSTGRES_DB=taxi_booking
POSTGRES_USER=taxi_admin
POSTGRES_PASSWORD=CHANGE_ME_admin_password
# Tài khoản ứng dụng (chỉ SELECT/INSERT/UPDATE)
APP_DB_PASSWORD=CHANGE_ME_app_password
# Tài khoản báo cáo (chỉ đọc)
REPORT_DB_PASSWORD=CHANGE_ME_report_password
# Tài khoản cho postgres-exporter (pg_monitor)
MONITOR_DB_PASSWORD=CHANGE_ME_monitor_password

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@taxibooking.vn
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password
